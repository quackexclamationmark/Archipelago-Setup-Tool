      m_Calls: []
  m_text: "Once everything is set up, a new \"Archipelago\" window should appear
    in the top-left corner of your screen in Subnautica.\n\nEnter archipelago.gg:XXXXX
    in the \"Host\" field, where XXXXX is the room\u2019s port. You can find this
    number on the website after creating a new room.\n\nIn \"PlayerName\", enter
    the name assigned to your YAML file.\n\nThe \"Password\" field is optional. If
    the host did not set one, leave it blank.\n\nFinally, click \"Connect\" and start
    a new run!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
