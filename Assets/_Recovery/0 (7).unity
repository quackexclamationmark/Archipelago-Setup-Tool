  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When you click \"START SETUP\" in the \"SETUP\" tab, repo.apworld will
    be installed and moved into the \"custom_worlds\" folder inside the Archipelago
    Launcher directory. \nBepInEx will then be downloaded into the REPO core files,
    along with the required mods, which will be placed in REPO\\BepInEx\\plugins.
    The game will then launch and automatically close after a few seconds to ensure
    BepInEx is correctly initialized.\nThen \"BepInEx.cfg\" & \"REPOLib.cfg\" (in
    REPO\\BepInEx\\config) will be modified to match the required setup.\nAt the
    moment, only the manual setup is supported. The mod manager setup might be added
    in the future."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
