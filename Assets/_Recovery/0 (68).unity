  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Once everything is set up, click the 'Mods' button in the main menu (the
    4th button). Go to 'Archipelago Dredge'.\n\nIn the \"Server Address\" field,
    enter archipelago.gg. \n\nIn \"Port\" enter the room's port. This is a 5-digit
    number that you can find on the website after creating a new room.\n\nIn \"Slot
    Name\", enter the name assigned to your YAML file.\n\nThe \"Password\" field
    is optional. If the host did not set one, leave it blank.\n\nFinally, start a
    fresh new save and once you've finished the intro cutscene, press 'F8' and a
    pop-up saying \"Archipelago Connected\" should appear!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
