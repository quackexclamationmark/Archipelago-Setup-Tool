  m_text: 'When you click "START SETUP" in the SETUP tab, untitled_goose_game.apworld
    will be installed and moved into the custom_worlds folder within the Archipelago
    Launcher directory.

    BepInEx will then be downloaded into the UGG game directory,
    along with the UGG-Archipelago folder, which will be placed in BepInEx\plugins.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
