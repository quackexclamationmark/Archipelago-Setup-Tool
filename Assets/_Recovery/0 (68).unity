  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A server address consists of 5 parts:\n\n\n\u2022 '/connect' or 'connect'
    are rarely necessary and are mostly useful for games that use a console for connection.\n\n\u2022
    The 'address'/'ip', it's always \"archipelago.gg\" OR \"localhost\" in the case
    that you are hosting locally.\n\n\u2022 The 'port', it's a 5-digit number that
    you can find on the AP website after opening a room.\n\n\u2022 The 'player slot'
    is the name assigned to your YAML. Can also be found on the website in the players
    list.\n\n\u2022 The 'password' is very optional."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
