  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Once everything is set up and that you are in the game, start a new save
    file.\n\nPress \"/\" to open the text chat and type /connect archipelago.gg:
    followed by the port. This is a 5-digit number that you can find on the website
    after creating a new room.\nFor example: /connect archipelago.gg:12345\n\nAfter
    that, the text chat will ask you to enter your slot name, enter the name assigned
    to your YAML file. \n\nFinally, it will ask you to type the password, if there's
    no password, simply type \"n\" and then ENTER.\n\nAnd you are connected, you
    can now start playing."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
