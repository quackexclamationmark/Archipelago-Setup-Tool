      m_Calls: []
  m_text: "Once everything is set up, a new \"Archipelago\" window should appear
    in the top-left corner after clicking \"START GAME\".\n\nIn \"Slot Name\", enter
    the name assigned to your YAML file.\n\nIn the \"Server\" field, enter archipelago.gg.
    \n\nIn \"Port\" enter the room's port. This is a 5-digit number that you can
    find on the website after creating a new room.\n\nThe \"Password\" field is optional.
    If the host did not set one, leave it blank.\n\nFinally, you can start a new
    run and it should connect you!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
