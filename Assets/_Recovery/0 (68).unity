      m_Calls: []
  m_text: "Once everything is set up, you should be able to press F1 when inside
    the game to open a new 'Archipelago' window.\n\nIn the \"Server\" field, enter
    archipelago.gg. In front of it there is a separated text field, enter the room\u2019s
    5-digit port number. You can find this number on the website after creating a
    new room.\n\nIn \"Slot\", enter the name assigned to your YAML file.\n\nThe \"Password\"
    field is optional. If the host did not set one, leave it blank.\n\nFinally, click
    \"Connect\" and then, you can start a new run!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
