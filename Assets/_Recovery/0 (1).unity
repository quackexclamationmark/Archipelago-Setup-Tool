  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When you click \"START SETUP\" in the \"SETUP\" tab, repo.apworld will
    be installed and transfered into the \"custom_worlds\" folder inside the Archipelago
    Launcher's files. \nBepInEx will be downloaded into the REPO core files alongside
    the remaining mods that will go into REPO\\BepInEx\\plugins. After that the game
    will start and close a few seconds later to make sure that BepInEx loads correctly.\nThen
    (in REPO\\BepInEx\\config) the \"BepInEx.cfg\" & \"REPOLib.cfg\" files will be
    modified to match the requirements.\nOnly the manual setup is compatible for
    now, could add the mod manager setup later, maybe?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
