      m_Calls: []
  m_text: "Once everything is set up, a new \"Archipelago\" button should appear
    in the main menu.\n\nEnter archipelago.gg in the \"HOST\" field, then enter the
    room\u2019s 5-digit port number in \"PORT\". You can find this number on the
    website after creating a new room.\n\nIn \"SLOT\", enter the name assigned to
    your YAML file.\n\nThe \"PASSWORD\" field is optional. If the host did not set
    one, leave it blank.\n\nFinally, click \"CONNECT TO AP\" and then, you can start
    a new run!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
