  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Once everything is set up, a new "Mods" button should appear in the main
    menu in the bottom-right corner, click it and then, click the little cog icon
    located under the "Bloons Archipelago" mod button.


    In the "URL" field,
    enter "archipelago.gg".


    In the "PORT" field, enter the port. This is a
    5-digit number that you can find on the website after creating a new room.


    In
    "SLOT", enter the name assigned to your YAML file.


    The "Password" field
    is optional. If the host did not set one, leave it blank.


    Finally, click
    "ARCHIPELAGO CONNECT" and then you can start playing!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
