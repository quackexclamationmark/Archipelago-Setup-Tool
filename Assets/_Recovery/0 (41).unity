  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When you click \"REVERT\" in the SETUP tab, the BepInEx folder, .doorstop_version,
    doorstop_config.ini, and winhttp.dll will be removed from the game directory.\n\nThe
    \"Clear all mods\" option is enabled by default. If other mods that are not required
    for Archipelago are detected during the revert process, an additional confirmation
    prompt will appear asking whether you want to remove them.\n\nIf you want to
    keep those mods, click \"NO\", then disable the option and run the revert again.
    If you want to remove everything, simply click \"YES\", and BepInEx will be completely
    removed.\n\nYou can also revert changes made to the configuration files by enabling
    the \"Patch Configs\" option.\n\t"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
