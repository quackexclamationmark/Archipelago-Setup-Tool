--- !u!114 &1463629105
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1463629103}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Some games have a PopTracker integration for Archipelago which allows
    you to track all possible Locations, Items, Upgrades, Zones, Hints and more depending
    on the game.\n\nFor the setup there are 3 different cases:\n\n\t\u2022 If the
    selected directory does not contain a PopTracker folder (or any similarly named
    folder), a new \"poptracker\" folder will be created and the pack will be downloaded
    to poptracker\\packs.\r\n\n\n\t\u2022 If the selected directory already contains
    a folder with \"PopTracker\" in its name, the installer will look for a poptracker.exe
    file. If one is found, the pack will be downloaded to its packs folder. If no
    poptracker.exe is found, the folder will be renamed to \"poptracker\" and any
    missing files or folders will be created.\r\n\n\n\t\u2022 If the selected directory
    is already a PopTracker folder (for example: C:\\Users\\magni\\Documents\\poptracker),
    its contents will be validated. If everything is present, the pack will simply
    be downloaded to poptracker\\packs. Otherwise, the folder will be repaired before
    the pack is installed.\n\t"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
