  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Once everything is set up, click "Start Game", click the Archipelago icon
    next to an empty save slot, after doing so, a new window should open.


    In
    "name", enter the name assigned to your YAML file.


    In the "address" field,
    enter archipelago.gg: followed by the port. This is a 5-digit number that you
    can find on the website after creating a new room.


    The "password" field
    is optional. If the host did not set one, leave it blank.


    Finally, click
    the little check icon to connect and then you can start playing!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
