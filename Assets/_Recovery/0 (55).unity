  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Once everything is set up, you should be able to see an Archipelago icon
    in the bottom-left corner in the main menu. If you do see it, open a lobby, press
    ESCAPE and there should be a \"Archipelago\" button, click it.\n\nIn the \"SERVER\"
    field, enter archipelago.gg.\n\nIn \"PORT\" enter the room\u2019s 5-digit port
    number. You can find this number on the website after creating a new room.\n\nIn
    \"SLOT NAME\", enter the name assigned to your YAML file.\n\nThe \"PASSWORD\"
    field is optional. If the host did not set one, leave it blank.\n\nFinally, click
    \"Connect\" and then, you can start a new run!\n\nYou can also go in the \"LINKS\"
    tab to change the AP rules and the \"TRACKER\" tab to follow your progress in
    the Archipelago world."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
