      m_Calls: []
  m_text: 'When you click "START SETUP" in the "SETUP" tab, bloonstd6.apworld will
    be installed and moved into the "custom_worlds" folder inside the Archipelago
    Launcher directory. MelonLoader will then be installed into the game''s core
    folder. Both required dlls will be installed inside the BloonsTD6\Mods directory.

    Only
    the Mods folder will be created automatically, the other ones will be created
    after starting the game.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
