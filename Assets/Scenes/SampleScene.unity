  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When you click \"START SETUP\" in the \"SETUP\" tab, tcg_card_shop_simulator.apworld
    will be installed and moved into the \"custom_worlds\" folder inside the Archipelago
    Launcher directory. \nBepInEx will then be downloaded into the TCGCSS core files,
    along with the required mods, which will be placed in BepInEx\\plugins. The game
    will then launch and automatically close after a few seconds to ensure BepInEx
    is correctly initialized.\nThen \"BepInEx.cfg\" (in BepInEx\\config) will be
    modified to match the required setup."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
