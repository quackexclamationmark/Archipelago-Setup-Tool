      m_Calls: []
  m_text: "When you click \"START SETUP\" in the \"SETUP\" tab, adofai.apworld will
    be installed and moved into the \"custom_worlds\" folder inside the Archipelago
    Launcher directory. \nBepInEx will then be downloaded into the ADOFAI core files,
    along with the required Archipelago DLLs, which will be placed in BepInEx\\plugins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
