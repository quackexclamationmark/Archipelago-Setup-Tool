      m_Calls: []
  m_text: "Once everything is set up, and that you're in the main menu, click \"START\"
    and then press \"C + Z\" to open a new Archipelago connection window.\n\nIn the
    \"ADDRESS\" field, enter archipelago.gg. \n\nIn \"PORT\" enter the room's port.
    This is a 5-digit number that you can find on the website after creating a new
    room.\n\nIn \"PLAYER\", enter the name assigned to your YAML file.\n\nThe \"PASSWORD\"
    field is optional. If the host did not set one, leave it blank.\n\nFinally, set
    enable to \"YES\" and create a new save on the spot that has a \"AP\" icon in
    the top-right corner of it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
