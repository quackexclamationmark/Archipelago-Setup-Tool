      m_Calls: []
  m_text: 'Once everything is set up, open the game. Once it''s open, launch "The.Witness.Randomizer.for.Archipelago.exe".


    In
    the "AP address" field, enter archipelago.gg: followed by the port. This is a
    5-digit number that you can find on the website after creating a new room.


    In
    "slot name", enter the name assigned to your YAML file.


    The "password"
    field is optional. If the host did not set one, leave it blank.


    Finally,
    click "Connect" and start a new run!


    You can also change some AP settings!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
