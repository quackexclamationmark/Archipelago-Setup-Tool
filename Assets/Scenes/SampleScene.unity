  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Let's say you didn't have any launch option enabled. Once everything is
    set up, launch 'SHARRandomizerFrontend.exe' inside the new Archipelago folder
    in your game's folder and launch the Archipelago Launcher.\nWith the newly installed
    simpsonshitnrun.apworld file, you should be able to find a new \"Simpsons Hit
    & Run Client\". Don't open it yet. The host of your Archipelago session will
    need to go to the Archipelago website and go to the room that you are going to
    use for your Archipelago session. There, you should be able to find a button
    that says \"Download Patch File\" next to your name. Download it, and once you
    have it, you can move on to the next step.\n\nYou can now open the Simpsons Hit
    & Run Client and it will ask you to select the path to certain executables. When
    it is asking you to \"Select a .apshar patch\" you will need to select the patch
    file that you just downloaded from the website.\nThen, it should open the game.\n\nNow
    go back to 'SHARRandomizerFrontend.exe'.\n\nIn the \"Server\" field, enter archipelago.gg.\n\nIn
    \"Port\" enter the room\u2019s 5-digit port number. You can find this number
    on the website after creating a new room.\n\nIn \"Slot\", enter the name assigned
    to your YAML file.\n\nThe \"Password\" field is optional. If the host did not
    set one, leave it blank.\n\nFinally, click \"Connect\" and then, you can start
    a new run!\n\nNow, go back to the game and you should be able to start a game
    while connected to the AP server! :)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
