      m_Calls: []
  m_text: "Once everything is set up, a new \"ARCHIPELAGO\" window should appear.\n\nOnce
    in-game, press ESCAPE, then, F10 and type \"connect archipelago.gg:XXXXX [slotname]
    [optional password]\"\n\nXXXXX is the room\u2019s port. You can find this number
    on the website after creating a new room.\n\n\"[slotname]\" is the name assigned
    to your yaml file.\n\n\"[optional password]\" is optional.\n\nFinally, press
    \"Enter\" and you should be able to start playing!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
