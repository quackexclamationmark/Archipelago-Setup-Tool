  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Once everything is set up, a new mod window should appear in the main
    menu. Go to 'Mod Manager', load 'ModUtils' first by clicking the little plug
    icon next to it and then do the same for 'Raftipelago'. Finally, press 'F10'.\n\nOnce
    in-game, press ESCAPE, then, F10 and type \"connect archipelago.gg:XXXXX [slotname]\"\n\nXXXXX
    is the room\u2019s port. You can find this number on the website after creating
    a new room.\n\n\"[slotname]\" is the name assigned to your yaml file.\n\nFinally,
    press 'ENTER' and you can start playing!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
