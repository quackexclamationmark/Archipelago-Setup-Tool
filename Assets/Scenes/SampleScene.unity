      m_Calls: []
  m_text: "You have 2 revert options, both can't be enabled at the same time.\n\nIf
    you use the \"Clear AP Mods\" option it will only delete the mods that are required
    for DREDGE Archipelago.\n\nIf you use the \"Full Clear\" option it will delete
    everything related to DREDGE mods. If other mods are detected an additionnal
    confirmation will appear.\n\t"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
