  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Once everything is set up, a new "Archipelago" window should appear in
    the top-left corner of the main menu.


    In the "Host" field, enter archipelago.gg:
    followed by the port. This is a 5-digit number that you can find on the website
    after creating a new room.


    In "Slot Name", enter the name assigned to your
    YAML file.


    The "Passworld" field is optional. If the host did not set one,
    leave it blank.


    Finally, click "Connect" and then, you can start a new
    run!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
