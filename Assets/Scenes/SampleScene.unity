  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When you click \"START SETUP\" in the \"SETUP\" tab, fez.apworld will
    be installed and moved into the \"custom_worlds\" folder inside the Archipelago
    Launcher directory. \nHAT will be installed into the game's core folder and 'hat_install.bat'
    will be executed which will create \"MONOMODDED_FEZ.exe\". The AP Mod .zip folder
    will be installed inside the FEZ\\Mods directory."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
