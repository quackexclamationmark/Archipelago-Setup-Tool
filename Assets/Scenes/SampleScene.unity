  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Once everything is set up, a new \"AP Client\" window should appear in
    the top-left corner of the main menu.\n\nEnter archipelago.gg in the \"Address:Port\"
    field, then enter the room\u2019s 5-digit port number in \"PORT\". You can find
    this number on the website after creating a new room.\n\nThe \"Password\" field
    is optional. If the host did not set one, leave it blank.\n\nIn \"Slot\", enter
    the name assigned to your YAML file.\n\nFinally, click \"Connect\" and then,
    you can start a new run!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
