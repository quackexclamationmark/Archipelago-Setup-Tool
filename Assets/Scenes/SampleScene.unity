  m_text: "\u2022 BepInEx (+ .doorstop_version, doorstop_config.ini & winhttp.dll)\n\u2022
    MenuLib.dll\n\u2022 RepoLib.dll\n\u2022 RepoAP.dll + Archipelago.repobundle (Archipelago
    Mod)\n\u2022 repo.apworld\n"
