      m_Calls: []
  m_text: Minecraft is not a core Archipelago game, it needs a custom world file.
    When "minecraft.apworld" is downloaded in the Archipelago Folder (by clicking
    START SETUP), boot-up the Archipelago Launcher and go to "Options Creator" to
    create your .yaml file and then, when you're done, send it to the person who
    will host the AP Multiworld.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
  m_sharedMaterial: {fileID: -9134737203265703719, guid: ba3e8b9dcf9de2d42a10ea892d87cb9d, type: 2}
