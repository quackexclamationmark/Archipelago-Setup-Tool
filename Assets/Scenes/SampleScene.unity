  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You have 3 revert options, using Full Clear will disable the other 2 until
    you turn it off.\n\nIf you use the \"Clear AP Mods\" option it will only delete
    the mods that are required for TCGCSS Archipelago.\n\nIf you use the \"Full Clear
    BepInEx\" option it will delete everything related to BepInEx and mods. If other
    mods are detected an additionnal confirmation will appear.\n\t\n\nYou can also
    revert changes made to the configuration files by enabling the \"Patch Configs\"
    option.\n\t"
  m_isRightToLeft: 0
